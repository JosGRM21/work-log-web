# ==============================================================================
# WorkLogWeb - Plantilla de Variables de Entorno para Producción
# ==============================================================================

# 1. Base de Datos Relacional PostgreSQL (Neon / Supabase / AWS RDS)
# Formato: postgresql://<user>:<password>@<host>:<port>/<db_name>?sslmode=require
DATABASE_URL="postgresql://worklog_admin:YOUR_SECURE_DB_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/work_log_web_prod?sslmode=require"

# 2. Entorno y Seguridad
NODE_ENV="production"
PORT=3000
CLIENT_URL="https://worklog.example.com"

# Clave secreta para firma HMAC-SHA256 de cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET="REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES"

# 3. Almacenamiento de Objetos en Producción (Cloudflare R2 / AWS S3)
STORAGE_DRIVER="s3"
STORAGE_BUCKET="work-log-web-production-media"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="YOUR_R2_OR_S3_ACCESS_KEY_ID"
STORAGE_SECRET_KEY="YOUR_R2_OR_S3_SECRET_ACCESS_KEY"
STORAGE_REGION="auto"
# Dominio CDN público o subdominio asignado al bucket:
STORAGE_PUBLIC_BASE_URL="https://media.worklog.example.com"

# 4. Cuotas y Límites de Carga Multimedia (RNF-STOR-01)
# 10 MB para imágenes (10 * 1024 * 1024)
MAX_IMAGE_SIZE_BYTES=10485760
# 150 MB para videos (150 * 1024 * 1024)
MAX_VIDEO_SIZE_BYTES=157286400
